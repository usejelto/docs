    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.9.2",
    "jsdom": "^26.1.0",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^5.0.0"
  }
